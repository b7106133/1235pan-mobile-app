<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.pan.mobile"
    android:versionCode="170"
    android:versionName="1.7.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 读取剪贴板：应用在前台时用于识别 123 分享链接并自动打开（Android 10+ 仅前台可读） -->
    <uses-permission android:name="android.permission.READ_CLIPBOARD"
        tools:ignore="ProtectedPermissions" />
    <!-- 前台服务保活：下载进行中提升进程优先级，避免挂后台被系统杀死导致下载失败 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="123\u4e91\u76d8"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name="com.pan.mobile.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection|navigation|keyboard|touchscreen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.123pan.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="www.123pan.cn" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="123pan.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="123pan.cn" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="share.123pan.cn" />
                <data android:scheme="https" android:host="*.share.123pan.cn" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="123pan" />
            </intent-filter>

            <!-- 跨盘：夸克/UC/天翼 https 分享链接 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.quark.cn" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="drive.uc.cn" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="fast.uc.cn" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="cloud.189.cn" android:pathPrefix="/t/" />
            </intent-filter>

            <!-- 跨盘 App 专属 scheme（官方 APK 实扒） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="quark" />
                <data android:scheme="qkcloudlink" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="uclink" />
                <data android:scheme="uclink2" />
                <data android:scheme="ucweb" />
                <data android:scheme="ucpro" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cloud189" />
            </intent-filter>

            <!-- 网页/其他App「分享 → 123云盘」 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pan" android:host="umeng.com" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pan" />
            </intent-filter>
        </activity>

        <provider
            android:name="com.pan.mobile.PanProvider"
            android:authorities="com.pan.mobile.pan"
            android:grantUriPermissions="true"
            android:exported="true" />
        <service
            android:name="com.pan.mobile.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
